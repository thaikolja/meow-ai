{
  "name":            "meow.yanawa.io",
  "version":         "1.6.0",
  "private":         true,
  "type":            "module",
  "description":     "Cat-themed Nuxt chat interface for focused AI-powered German practice.",
  "scripts":         {
    "build":       "mkdir -p /tmp/meow-sockets && TMPDIR=/tmp/meow-sockets nuxt build",
    "dev":         "mkdir -p /tmp/meow-sockets && TMPDIR=/tmp/meow-sockets nuxt dev",
    "generate":    "nuxt generate",
    "preview":     "nuxt preview",
    "postinstall": "nuxt prepare",
    "test":        "bun test tests",
    "test:vitest": "vitest run",
    "test:e2e":    "playwright test",
    "typecheck":   "tsc -p .nuxt/tsconfig.json --noEmit && tsc -p .nuxt/tsconfig.node.json --noEmit"
  },
  "dependencies":    {
    "@nuxt/ui":       "^4.12.0",
    "better-sqlite3": "^13.0.3",
    "highlight.js":   "^11.12.0",
    "marked":         "^18.2.0",
    "nuxt":           "^4.6.4",
    "sanitize-html":  "^2.18.1",
    "vue":            "3.5.45",
    "vue-router":     "5.4.0"
  },
  "overrides":       {
    "vue":                    "3.5.45",
    "@vue/compiler-core":     "3.5.45",
    "@vue/compiler-dom":      "3.5.45",
    "@vue/compiler-sfc":      "3.5.45",
    "@vue/compiler-ssr":      "3.5.45",
    "@vue/reactivity":        "3.5.45",
    "@vue/runtime-core":      "3.5.45",
    "@vue/runtime-dom":       "3.5.45",
    "@vue/server-renderer":   "3.5.45",
    "@vue/shared":            "3.5.45"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "^1.2.14",
    "@iconify-json/lucide":       "^1.2.153",
    "@iconify-json/mdi":          "^1.2.3",
    "@nuxt/fonts":                "0.14.0",
    "@nuxt/image":                "^2.2.1",
    "@nuxt/test-utils":           "^4.4.0",
    "@playwright/test":           "^1.65.0",
    "@types/node":                "^26.6.6",
    "@types/sanitize-html":       "^2.16.2",
    "@vue/language-core":         "^3.3.14",
    "@vue/test-utils":            "^2.5.1",
    "bun-types":                  "^1.4.4",
    "happy-dom":                  "21.0.4",
    "playwright":                 "^1.65.0",
    "typescript":                 "^7.0.2",
    "vitest":                     "^5.1.0",
    "vue-language-server":        "^0.0.67"
  }
}

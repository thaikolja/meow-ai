# Meow 1.6.0. Local and generated files stay out of git.
# Markdown is ignored except README.md, CHANGELOG.md, and public/*.md.

node_modules
*.log
.nuxt
.nitro
.cache
.output
.env
dist
.DS_Store
.idea
*.md
!README.md
!CHANGELOG.md
!/public/*.md

# Per-username settings and chats. The catalog file stays tracked.
.data/accounts/

# Local Serena project index
.serena/

# Test coverage and browser runs
coverage/
.nuxt-e2e
test-results/
playwright-report/
blob-report/

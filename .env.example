# Meow 1.5.0 environment template. Copy to `.env`. Do not commit `.env`.

# OpenRouter API key. Used by server API proxy when forwarding requests to OpenRouter
NUXT_OPENROUTER_API_KEY=

# DeepSeek API key
NUXT_DEEPSEEK_API_KEY=

# Default provider id exposed to the client (runtime public config). Controls which provider the UI selects by default.
NUXT_PUBLIC_DEFAULT_PROVIDER=openrouter-default

# Default model identifier (public runtime config). Used as the preselected model for new chats or requests.
# Must be an id from .data/models.json. Gemini 3.8 Flash is the shipped fallback.
NUXT_PUBLIC_DEFAULT_MODEL=google/gemini-3.8-flash

# House password for the cat-flap gate. Replace this before production. Runtime config `appPassword`.
NUXT_APP_PASSWORD=replace-me

# Path to the directory which contains available LLMs (Default: empty -> `./.data`)
NUXT_DATA_DIR=./.data

# Session secret used to sign cookies. Replace this before production. Falls back to NUXT_APP_PASSWORD when empty.
NUXT_SESSION_SECRET=replace-me-too

# Allow private or internal provider hosts in assertProviderBaseUrl(). Leave false unless you need it.
NUXT_ALLOW_PRIVATE_PROVIDER_URLS=false

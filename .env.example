# Deepseek provider API key (dev placeholder). Used by server API proxy when forwarding requests to the Deepseek/LMM provider.
NUXT_DEEPSEEK_API_KEY=

# GROQ/Sanity style API key (dev placeholder). Used for provider requests that require a GROQ key.
NUXT_GROQ_API_KEY=

# Google API key for Google/Gemini integrations. Public key used by frontend or server depending on runtime config.
NUXT_GOOGLE_API_KEY=

# Default provider id exposed to the client (runtime public config). Controls which provider the UI selects by default.
NUXT_PUBLIC_DEFAULT_PROVIDER=gemini-default

# Default model identifier (public runtime config). Used as the preselected model for new chats or requests.
NUXT_PUBLIC_DEFAULT_MODEL=models/gemini-3.1-flash-lite-preview

# Default application password (fallback/setup). Keep this for local/dev only; change before production.
NUXT_DEFAULT_APP_PASSWORD=sine

# Application password used for simple password-based login (runtime config `appPassword`).
# The server sets a `chat_username` cookie on successful login.
NUXT_APP_PASSWORD=change-me-in-production

# Session secret used to sign/secure cookies or session-related data on the server.
NUXT_SESSION_SECRET=

# Toggle allowing private/provider base URLs (helps prevent SSR/server from calling arbitrary internal URLs).
# Set to "true" only if you intentionally allow private/internal provider endpoints.
NUXT_ALLOW_PRIVATE_PROVIDER_URLS=false


# OpenRouter API key. Used by server API proxy when forwarding requests to OpenRouter
# (https://openrouter.ai), an OpenAI-compatible aggregator.
NUXT_OPENROUTER_API_KEY=

# DeepSeek API key. Used only when the selected model is DeepSeek.
# Requests go to https://api.deepseek.com/chat/completions with model id deepseek-flash.
NUXT_DEEPSEEK_API_KEY=

# Default provider id exposed to the client (runtime public config). Controls which provider the UI selects by default.
NUXT_PUBLIC_DEFAULT_PROVIDER=openrouter-default

# Default model identifier (public runtime config). Used as the preselected model for new chats or requests.
NUXT_PUBLIC_DEFAULT_MODEL=google/gemini-2.5-flash

# Since no sensitive data is stored, there's no "real" authentication. Just a hard-coded password.
# runtime config `appPassword`
NUXT_APP_PASSWORD=

# Session secret used to sign/secure cookies or session-related data on the server.
NUXT_SESSION_SECRET=

# Toggle allowing private/provider base URLs (helps prevent SSR/server from calling arbitrary internal URLs).
# Set to "true" only if you intentionally allow private/internal provider endpoints.
NUXT_ALLOW_PRIVATE_PROVIDER_URLS=true
